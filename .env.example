# Clé de l'API Claude : à coller dans Vercel (Settings > Environment Variables), jamais dans le code
ANTHROPIC_API_KEY=
# Modèle utilisé pour rédiger les devis (Claude Haiku 5.5 par défaut, le plus économique)
FLASHDEVIS_MODEL=claude-haiku-5-5
# Supabase (Project Settings > API) : sans ces deux variables, l'appli tourne en mode démo, données dans le navigateur
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Stripe (offre Pro) : clé secrète, identifiant du prix mensuel, secret du webhook (Developers > Webhooks)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Supabase, côté serveur uniquement (webhook Stripe) : clé service_role, SANS préfixe VITE_ pour qu'elle ne parte jamais dans l'appli
SUPABASE_SERVICE_ROLE_KEY=
# Brevo (e-mail à l'artisan quand son client signe) : clé API (SMTP et API, onglet Clés API) et adresse d'expéditeur validée
BREVO_API_KEY=
BREVO_EXPEDITEUR=
